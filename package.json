{
  "name": "payments-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "Exercises for the workshop \"Payments and Monetization at Scale for Frontend Engineers\" by Faris Aziz",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "scripts": {
    "exercise": "node scripts/lab.mjs exercise",
    "solution": "node scripts/lab.mjs solution",
    "compare": "node scripts/lab.mjs compare",
    "reset": "node scripts/lab.mjs reset",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-docs.mjs",
    "test": "vitest run --project core --project solution",
    "test:exercise": "node scripts/lab.mjs test-exercise",
    "test:watch": "vitest --project core --project solution",
    "e2e": "node scripts/lab.mjs e2e solution",
    "e2e:exercise": "node scripts/lab.mjs e2e exercise",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/themes": "3.3.0",
    "@stacknotes/lab-core": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
